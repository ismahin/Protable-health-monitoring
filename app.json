{
  "expo": {
    "name": "PHMS",
    "slug": "phms-web",
    "version": "1.1.0",
    "platforms": [
      "web"
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    }
  }
}
